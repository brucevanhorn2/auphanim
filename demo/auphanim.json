{
  "watchers": [
    {
      "name": "System",
      "type": "sysmetrics",
      "poll_interval_s": 2,
      "max_events": 50
    },
    {
      "name": "Demo DB",
      "type": "postgres",
      "dsn": "postgres://demo:demo@localhost:5432/demo",
      "tables": ["users", "orders"],
      "poll_interval_s": 2,
      "mode": "lightweight",
      "max_events": 50
    },
    {
      "name": "Events",
      "type": "kafka",
      "brokers": ["localhost:9092"],
      "topics": ["demo.events"],
      "group_id": "auphanim-demo",
      "offset": "latest",
      "max_events": 50
    },
    {
      "name": "Receipts",
      "type": "filesystem",
      "path": "/tmp/auphanim-demo",
      "recursive": false,
      "patterns": ["*.json"],
      "max_events": 50
    },
    {
      "name": "Cache",
      "type": "redis",
      "addr": "localhost:6379",
      "password": "",
      "db": 0,
      "pattern": "*",
      "poll_interval_s": 2,
      "show_values": true,
      "max_events": 50
    },
    {
      "name": "App Logs",
      "type": "logfile",
      "paths": ["/tmp/auphanim-demo/app.log"],
      "error_patterns": ["ERROR", "FATAL", "PANIC"],
      "max_events": 100
    }
  ]
}
